# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Only needed for the eval and the AI labelling scripts:
GEMINI_API_KEY=
OPENAI_API_KEY=
# Password for the whole app, and the secret that signs the session cookie:
DEMO_PASSWORD=
SESSION_SECRET=
# How many live AI runs are allowed per day:
DAILY_LIVE_RUNS=60

# Docker network of the reverse proxy in front of the app (docker-compose.yml):
# PROXY_NETWORK=proxy_default
